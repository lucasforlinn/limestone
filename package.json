{
  "name": "limestone-test-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript automation framework covering one UI and one API scenario.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "zod": "^3.24.0"
  }
}
